# Slack incoming webhook that receives deactivation alerts (required for alerts).
# Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/XXXX"

# MindBody accounts to watch (same vars as the main app; reuse api/.env if you like).
MB1_NAME="Abhishek More"
MB1_EMAIL="you@example.com"
MB1_PASSWORD="your-password"

MB2_NAME="Angel Chen"
MB2_EMAIL="other@example.com"
MB2_PASSWORD="other-password"

# --- Optional tuning ---
# How often to check, in minutes.
CHECK_INTERVAL_MINUTES=5
# Consecutive "deactivated" reads required before alerting (guards transients).
DEACTIVATION_CONFIRM_RUNS=2
# Extra comma-separated substrings that also count as "deactivated".
# DEACTIVATION_MARKERS="banned,terminated"
# Route the login probe through a proxy (same format the main app uses).
# PROXY_URL="http://user:pass@host:port"
# MindBody studio id (defaults to the aerial studio).
# MB_STUDIO_ID="836167"
